import gzip
import json
from datetime import date, datetime
from io import BytesIO

from fastapi import APIRouter, Depends, UploadFile, File, HTTPException
from fastapi.responses import StreamingResponse
from sqlalchemy.orm import Session
from sqlalchemy import select
from sqlalchemy.dialects.sqlite import insert as sqlite_insert

from app.database import get_db
from app.models.company import Company
from app.models.price import (
    LivePrice, NavValue, PriceHistory, IndexHistory, 
    CommodityPrice, MacroData, EconomicIndicator
)
from app.models.fundamental import StockOverview, FundamentalReport, QuarterlyGrowth

router = APIRouter(prefix="/api/system", tags=["System"])

# We define the models to export and their unique constraints for upserting
# (Model, index_elements)
EXPORT_MODELS = [
    (Company, ["symbol"]),
    (MacroData, ["date"]),
    (EconomicIndicator, ["indicator_name", "date_label"]),
    (CommodityPrice, ["date"]),
    (IndexHistory, ["index_name", "date"]),
    (StockOverview, ["symbol"]),
    (FundamentalReport, ["symbol", "quarter"]),
    (QuarterlyGrowth, ["symbol", "particulars", "fiscal_year", "quarter"]),
    (PriceHistory, ["symbol", "date"]),
    (LivePrice, ["company_id"]),
    (NavValue, ["company_id"]),
]

def serialize_row(row):
    d = {}
    for col in row.__table__.columns:
        val = getattr(row, col.name)
        if isinstance(val, (date, datetime)):
            d[col.name] = val.isoformat()
        else:
            d[col.name] = val
    return d

@router.get("/export-market-data")
def export_market_data(db: Session = Depends(get_db)):
    """Exports all global market data as a compressed JSON."""
    data = {}
    for model, _ in EXPORT_MODELS:
        rows = db.execute(select(model)).scalars().all()
        data[model.__tablename__] = [serialize_row(r) for r in rows]
    
    # Convert to JSON
    json_bytes = json.dumps(data).encode("utf-8")
    
    # Compress
    buf = BytesIO()
    with gzip.GzipFile(fileobj=buf, mode="wb") as f:
        f.write(json_bytes)
    
    buf.seek(0)
    return StreamingResponse(
        buf,
        media_type="application/gzip",
        headers={"Content-Disposition": 'attachment; filename="market_data_export.json.gz"'}
    )

@router.post("/import-market-data")
async def import_market_data(file: UploadFile = File(...), db: Session = Depends(get_db)):
    """Imports market data from a compressed JSON."""
    if not file.filename.endswith(".gz") and not file.filename.endswith(".json"):
        raise HTTPException(400, "File must be .json or .json.gz")
    
    content = await file.read()
    if file.filename.endswith(".gz"):
        content = gzip.decompress(content)
        
    data = json.loads(content)
    
    # Cache company symbol -> id mapping for tables requiring company_id
    company_map = {}

    for model, unique_cols in EXPORT_MODELS:
        table_name = model.__tablename__
        if table_name not in data:
            continue
            
        rows = data[table_name]
        if not rows:
            continue
            
        date_cols = [c.name for c in model.__table__.columns if str(c.type) in ('DATE', 'DATETIME')]
        
        valid_rows = []
        for row in rows:
            # Remove 'id' to prevent primary key collisions
            row.pop("id", None)
            
            # Resolve company_id based on symbol for LivePrice and NavValue
            if table_name in ("live_prices", "nav_values"):
                symbol = row.get("symbol")
                if symbol in company_map:
                    row["company_id"] = company_map[symbol]
                else:
                    # Try to fetch from DB if not in cache
                    comp_id = db.query(Company.id).filter(Company.symbol == symbol).scalar()
                    if comp_id:
                        company_map[symbol] = comp_id
                        row["company_id"] = comp_id
                    else:
                        continue # Skip if company doesn't exist
            
            # Convert date strings back to objects
            for col in date_cols:
                if row.get(col):
                    try:
                        if len(row[col]) > 10:
                            row[col] = datetime.fromisoformat(row[col])
                        else:
                            row[col] = date.fromisoformat(row[col])
                    except ValueError:
                        row[col] = None
                        
            valid_rows.append(row)
            
        if not valid_rows:
            continue

        # Calculate safe chunk size to stay under SQLite's 999 bind-parameter limit
        num_cols = len(valid_rows[0])
        chunk_size = max(1, 999 // num_cols)
        for i in range(0, len(valid_rows), chunk_size):
            chunk = valid_rows[i:i + chunk_size]
            stmt = sqlite_insert(model).values(chunk)
            
            # Exclude id and unique columns from UPDATE set
            update_dict = {c.name: c for c in stmt.excluded if c.name not in unique_cols and c.name != 'id'}
            
            if update_dict:
                stmt = stmt.on_conflict_do_update(index_elements=unique_cols, set_=update_dict)
            else:
                stmt = stmt.on_conflict_do_nothing(index_elements=unique_cols)
                
            db.execute(stmt)
            
        db.commit()
        
        # If we just imported companies, populate the initial cache
        if table_name == "companies":
            companies = db.query(Company.symbol, Company.id).all()
            company_map = {c.symbol: c.id for c in companies}
        
    return {"message": "Market data imported successfully", "success": True}
